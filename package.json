{
  "name": "newbee-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/__tests__/marketing-and-download.test.ts",
    "postinstall": "patch-package --error-on-fail && node scripts/security/check-braces.mjs",
    "check:security": "node scripts/security/check-braces.mjs",
    "ci": "npm run lint && npm run typecheck && npm run check:security && npm run test && npm run build",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm release-gate",
    "test:release": "docker compose -f docker-compose.test.yml run --rm release-gate"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "patch-package": "8.0.1"
  }
}
